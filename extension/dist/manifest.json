{
  "manifest_version": 3,
  "name": "Personal AI Assistant",
  "version": "1.0.0",
  "description": "Screen-aware multimodal AI assistant powered by Gemini",
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open AI Assistant"
  }
}